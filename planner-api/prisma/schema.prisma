// A URL de conexão não fica aqui: é montada em prisma.config.ts a partir das
// variáveis DB_*.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
  OTHER
  NOT_INFORMED
}

enum Role {
  DOCTOR
  ADMIN
}

model Patient {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @db.Uuid // gerado pela aplicação (sem default no banco)
  name      String
  phone     String
  email     String
  birthDate DateTime  @db.Date
  gender    Gender
  height    Int
  weight    Decimal   @db.Decimal(5, 2)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // O índice único parcial de email (WHERE "deletedAt" IS NULL) vive só na
  // migration patient_email_active_unique: o Prisma 7.10 não o modela no schema.
  @@map("patients")
}

model User {
  id           Int       @id @default(autoincrement())
  uuid         String    @unique @db.Uuid // gerado pela aplicação (sem default no banco)
  email        String    @unique
  passwordHash String? // opcional até a fatia Auth (#30)
  role         Role
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@map("users")
}
