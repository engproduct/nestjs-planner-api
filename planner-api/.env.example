# Desenvolvimento. Copie para .env: cp .env.example .env
# Valores batem com o serviço postgres-planner do ../docker-compose.yml.
# A URL de conexão é montada em código a partir destas variáveis
# (DB_PASSWORD é URL-encoded nesse momento; não faça escape manual).

PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=api_user
DB_PASSWORD=api_pass
DB_NAME=planner_db
DB_SCHEMA=public
